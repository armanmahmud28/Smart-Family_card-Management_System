# =============================================================================
# Git Ignore Configuration - Bangladesh Smart Family Card System
# =============================================================================

# 1. Dependency Directories (NEVER push - re-install with `npm install`)
node_modules/
backend/node_modules/
package-lock.json.bak

# 2. Environment Variables & Sensitive Credentials (CRITICAL - DO NOT PUSH)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 3. Log files & Debugging output
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. User-submitted Uploads / Runtime files (PII / storage)
uploads/
backend/uploads/
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 5. OS & System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 6. IDE / Editor configuration directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
